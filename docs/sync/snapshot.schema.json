{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:terminan:sync:v1:snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "cluster_generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "authority_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "QUORUM_CONFIRMED",
            "NO_QUORUM",
            "UNKNOWN"
          ]
        },
        "observed_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "fresh_until_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 64
        }
      },
      "required": [
        "state",
        "observed_at_utc",
        "fresh_until_utc",
        "evidence_refs"
      ]
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "fresh_until_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64
    },
    "control_stream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sequence_scope": {
          "enum": [
            "GLOBAL_CONTROL",
            "DATASET"
          ]
        },
        "dataset_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cluster_generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "schema_version": {
          "const": "1.0"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "retention_window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_seconds": {
              "type": "integer",
              "minimum": 600,
              "maximum": 604800
            },
            "earliest_available_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "minimum_seconds",
            "earliest_available_sequence"
          ]
        },
        "payload_size_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "stream_id",
        "sequence_scope",
        "dataset_id",
        "event_sequence",
        "cluster_generation",
        "schema_version",
        "cursor",
        "retention_window",
        "payload_size_limit"
      ]
    },
    "dataset_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stream_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "sequence_scope": {
            "enum": [
              "GLOBAL_CONTROL",
              "DATASET"
            ]
          },
          "dataset_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "event_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cluster_generation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "schema_version": {
            "const": "1.0"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "retention_window": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "minimum_seconds": {
                "type": "integer",
                "minimum": 600,
                "maximum": 604800
              },
              "earliest_available_sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "minimum_seconds",
              "earliest_available_sequence"
            ]
          },
          "payload_size_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "stream_id",
          "sequence_scope",
          "dataset_id",
          "event_sequence",
          "cluster_generation",
          "schema_version",
          "cursor",
          "retention_window",
          "payload_size_limit"
        ]
      },
      "maxItems": 128
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "resource_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "resource_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "metadata_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cluster_generation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 64
          },
          "value": {
            "type": "object",
            "maxProperties": 64
          }
        },
        "required": [
          "resource_id",
          "resource_type",
          "resource_revision",
          "metadata_revision",
          "cluster_generation",
          "evidence_refs",
          "value"
        ]
      },
      "maxItems": 1000
    },
    "snapshot_scope": {
      "enum": [
        "CONTROL",
        "DATASET"
      ]
    },
    "dataset_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataset_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "cluster_id",
    "cluster_generation",
    "revision",
    "cursor",
    "authority_status",
    "generated_at_utc",
    "fresh_until_utc",
    "evidence_refs",
    "control_stream",
    "dataset_streams",
    "resources",
    "snapshot_scope",
    "dataset_id",
    "dataset_revision"
  ]
}
